<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>

    <permission
        android:name="com.dsh.privtasker.sandbox.permission.SANDBOX"
        android:protectionLevel="signature"/>

    <application
        android:label="PrivTasker Sandbox"
        android:allowBackup="false"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Sandbox">

        <!-- 故意不声明 MAIN/LAUNCHER：安装后不会出现在桌面。
             PrivTasker 通过显式 Intent 启动这个 Activity。 -->
        <activity
            android:name=".SandboxActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!-- PrivTasker 通过 ContentResolver.call 执行沙箱命令。
             权限是 signature 级：只有同签名的 PrivTasker 能调用。 -->
        <provider
            android:name=".SandboxProvider"
            android:authorities="com.dsh.privtasker.sandbox.provider"
            android:exported="true"
            android:permission="com.dsh.privtasker.sandbox.permission.SANDBOX" />
    </application>
</manifest>

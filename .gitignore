.widget_preview/

# ---------------------------------------------------------------------------
# 字体（重要）
#
# 界面用的 San Francisco Display 是**苹果的字体**，授权范围不包括再分发；
# 测试里给系统族名当替身的 Noto Sans CJK 虽然是 OFL、可以分发，
# 但 17MB 放进仓库不值得。所以整个 assets/fonts/ 下的字体文件都排除掉，
# 仓库里只保留 assets/fonts/README.md 说明怎么准备。
#
# 注意：被忽略后本机仍可正常构建（文件还在），只是不会被提交。
# ---------------------------------------------------------------------------
/assets/fonts/*.ttf
/assets/fonts/*.ttc
/assets/fonts/*.otf

# 本地工作产物
/_tmp/
/icon/gen/

# golden 测试失败时生成的对比图（masterImage / testImage / maskedDiff …）
# 这些是排查用的临时产物，不该进仓库
/test/failures/

# Gradle 构建报告（不该进仓库）
/android/build/

# ͼ��Ԥ������ʱ���tools/icon_preview.py ���ɣ�
/tools/icon_preview/
/tools/__pycache__/


# Inter 4.1 (SIL OFL) ships with the app: declared in pubspec `fonts:`,
# so a clean clone must have these four files or `flutter build` fails.
!/assets/fonts/Inter-Regular.ttf
!/assets/fonts/Inter-Medium.ttf
!/assets/fonts/Inter-SemiBold.ttf
!/assets/fonts/Inter-Bold.ttf

# 本地调试用的地图脚本与截图（工程不引用，142 MB）
/baoding-roads/

# PowerShell 误写出来的文件名
/$(Test-Path
